# === Скопируйте этот файл в .env и заполните своими значениями ===

# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAAA...ваш_токен...

# ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=111111111,222222222

# Часовой пояс рассылки (IANA name). По умолчанию — МСК
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных SQLite
DATABASE_PATH=schedule.db
